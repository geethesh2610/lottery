# ---------------------------------------------------------------------------
# Kerala Lottery Pattern Analyzer — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Exposed to the browser (VITE_ prefix). Only public values here! ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server/CLI only. NEVER prefix these with VITE_. ---
# Settings > API > service_role (or secret) key. Used by scripts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Personal access token (https://supabase.com/dashboard/account/tokens) — lets the CLI link/deploy non-interactively.
SUPABASE_ACCESS_TOKEN=your-personal-access-token
# Database password chosen when the project was created.
SUPABASE_DB_PASSWORD=your-database-password
# Optional: derived from VITE_SUPABASE_URL when omitted.
SUPABASE_PROJECT_REF=

# --- Optional: admin login created automatically by `npm run db:setup` ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# true = disable public sign-ups via the Management API after creating the admin.
DISABLE_SIGNUP=true

# --- Optional: daily schedule (UTC cron). Default 11:30 UTC = 17:00 IST. ---
DAILY_RUN_CRON=30 11 * * *

# --- Optional: AI chat assistant (free) ---
# Free key from https://aistudio.google.com/apikey (no credit card). Stored as a
# function secret by `npm run functions:deploy`; never exposed to the browser.
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash).
GEMINI_MODEL=
